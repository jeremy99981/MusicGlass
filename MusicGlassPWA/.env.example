POSTGRES_DB=musicglass
POSTGRES_USER=musicglass
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://musicglass:change-me@postgres:5432/musicglass?sslmode=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:8090
PWA_PORT=8090
PORT=8081
NEXT_PUBLIC_API_BASE_URL=/api
PUBLIC_WEB_APP_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:3000,https://musicglass-pwa-test-20260616135652.netlify.app

# Stable remote access (Docker profile "remote"). Create a remotely-managed
# Cloudflare Tunnel and configure its public hostname to target http://proxy:80.
CLOUDFLARE_TUNNEL_TOKEN=

# If the frontend and backend use different HTTPS domains, bearer tokens keep
# authentication working even when the browser blocks third-party cookies.
# These cookie settings remain useful on browsers that accept them.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Optional, required for reliable YouTube Music playback/account context in the PWA.
# Flutter can read Google cookies from the native WebView cookie jar; a PWA cannot.
# Put valid backend-side YouTube Music cookies here if you want the Go API to resolve
# protected/anti-bot audio streams.
YOUTUBE_COOKIE_HEADER=
YOUTUBE_AUTH_HEADER=
YOUTUBE_VISITOR_DATA=

# Optional Google OAuth flow for linking the user's Google/YouTube identity from the PWA.
# This proves account linkage and can be used for official YouTube Data API reads.
# It does not provide SAPISID cookies and does not by itself unlock private YouTube Music audio streams.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8090/api/v2/providers/youtube/oauth/callback
